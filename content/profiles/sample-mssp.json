{
  "schema": "capstone-environment-profile/1",
  "id": "profile.sample-mssp",
  "version": "1.0.0",
  "name": "Sample managed security service provider",
  "publisher": "Capstone Labs, as a sample",
  "architecture": "One client estate under contract feeding one managed SOC; nine records govern the engagement from scoping to the evidence packet.",
  "infrastructure": [
    {
      "id": "endpoints",
      "label": "Endpoints",
      "purpose": "What staff work on; where phishing and malware land"
    },
    {
      "id": "servers",
      "label": "Servers",
      "purpose": "The systems the contract protects and the pentest targets"
    },
    {
      "id": "access",
      "label": "Access policy",
      "purpose": "Who may log in to each system, with what rights"
    },
    {
      "id": "hostctl",
      "label": "Host controls",
      "purpose": "The baseline firewall and access rules on each host"
    },
    {
      "id": "client-edge",
      "label": "Client edge",
      "purpose": "The boundary, and the one path the client’s logs take out"
    },
    {
      "id": "auditlog",
      "label": "Audit logging",
      "purpose": "Every login and change logged and shipped to the SIEM"
    },
    {
      "id": "scanner",
      "label": "Vulnerability scanner",
      "purpose": "Measures the estate against the baseline, scored"
    },
    {
      "id": "siem",
      "label": "SIEM / log platform",
      "purpose": "Collects the client’s logs and keeps them for the contract term"
    },
    {
      "id": "detections",
      "label": "Detection rules",
      "purpose": "Turns the client’s logs into alerts worth a ticket"
    },
    {
      "id": "tickets",
      "label": "Ticket queue",
      "purpose": "Every alert timed from raise to close: MTTD and MTTR"
    },
    {
      "id": "evidence",
      "label": "Evidence vault",
      "purpose": "Hashed copies of every artefact the packet cites"
    },
    {
      "id": "retest",
      "label": "Retest evidence",
      "purpose": "Each finding proved, fixed and proved again, hashed"
    }
  ],
  "tools": [
    "tool.auditd",
