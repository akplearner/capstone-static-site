  "ticketTaxonomy": [
    {
      "kind": "Security alert",
      "priority": "P1",
      "sla": {
        "acknowledge": "15 minutes",
        "resolve": "4 hours"
      }
    },
    {
      "kind": "Security alert",
      "priority": "P2",
      "sla": {
        "acknowledge": "1 hour",
        "resolve": "1 business day"
      }
    },
    {
      "kind": "Vulnerability finding",
      "priority": "critical",
      "sla": {
        "acknowledge": "1 business day",
        "resolve": "14 days"
      }
    },
    {
      "kind": "Change request",
      "priority": "standard",
      "sla": {
        "acknowledge": "1 business day",
        "resolve": "the next change window"
      }
    },
    {
      "kind": "Audit evidence request",
      "priority": "standard",
      "sla": {
        "acknowledge": "2 business days",
        "resolve": "10 business days"
      }
    }
  ],
