  "threshold": 10,
  "categories": [
    {
      "id": "tools",
      "label": "Tools",
      "unit": "A verified step on a task that uses the tool.",
      "success": "The pasted output held every expected token.",
      "dimensions": [
        "tools"
      ],
      "areas": [
        "sysadmin",
        "network",
        "detect",
        "recon",
        "vuln",
        "cloud",
        "automation",
        "observe"
      ]
    },
    {
      "id": "commands",
      "label": "Commands",
      "unit": "A verified required step that runs a command.",
      "success": "The output matched on the first or a later paste.",
      "dimensions": [],
      "areas": [
        "sysadmin",
        "network",
        "detect",
        "recon",
        "exploit",
        "cloud",
        "automation",
        "virt"
      ]
    },
    {
      "id": "procedures",
      "label": "Procedures",
      "unit": "A procedure started: a mapped form with data or a mapped task ticked.",
      "success": "Followed: every check due met and document control complete.",
      "dimensions": [
        "procedures"
      ],
      "areas": [
        "ops",
        "continuity",
        "respond",
        "sysadmin",
        "docs"
      ]
    },
    {
      "id": "standards",
      "label": "Standards",
      "unit": "A standard tagged on ticked work or cited by a form of the role.",
      "success": "Tagged on verified output or cited by an approved form.",
      "dimensions": [
        "standards"
      ],
      "areas": [
        "grc",
        "audit",
        "risk",
        "harden",
        "docs"
      ]
    },
    {
      "id": "troubleshooting",
      "label": "Troubleshooting",
      "unit": "A fault, incident or triage row the team logged, or a step verified after a failed paste.",
      "success": "The outcome column reads resolved, or the retry verified.",
      "dimensions": [
        "troubleshooting"
      ],
      "areas": [
        "ops",
        "respond",
        "sysadmin",
        "network",
        "observe",
        "hardware"
      ]
    },
    {
      "id": "investigations",
      "label": "Investigations",
      "unit": "A row on an investigation, triage, assessment or audit form, or a hashed evidence file.",
      "success": "A verdict, a fix or a transfer recorded on the row.",
      "dimensions": [
        "evidence"
      ],
      "areas": [
        "forensics",
        "detect",
        "respond",
        "vuln",
        "audit",
        "recon"
      ]
    },
    {
      "id": "documentation",
      "label": "Documentation",
      "unit": "A form the member drafted, submitted, reviewed or issued.",
      "success": "Approved by the team or by an instructor, or every check due met.",
      "dimensions": [
        "documentation"
      ],
      "areas": [
        "docs",
        "report",
        "grc"
      ]
    },
    {
      "id": "architectures",
      "label": "Architectures",
      "unit": "A row on a design, topology, plan or architecture form of the role.",
      "success": "The form reached approved or issued.",
      "dimensions": [],
      "areas": [
        "arch",
        "network",
        "cloud",
        "data",
        "continuity"
      ]
    },
    {
      "id": "configurations",
      "label": "Configurations",
      "unit": "A row on a configuration, baseline or hardening form, or a verified configuration step.",
      "success": "Verified from output or approved by the team.",
      "dimensions": [],
      "areas": [
        "harden",
        "sysadmin",
        "network",
        "identity",
        "cloud",
        "virt"
      ]
    },
    {
      "id": "communication",
      "label": "Communication",
      "unit": "A hand-off, a report filed, a note written, a peer review given or a handover form.",
      "success": "The hand-off closed, the report resolved, the review sent.",
      "dimensions": [
        "collaboration"
      ],
      "areas": [
        "report",
        "docs",
        "ops"
      ]
    },
    {
      "id": "collaboration",
      "label": "Collaboration",
      "unit": "A lifecycle move on a team form, or a step ticked on a teammate’s task.",
      "success": "The move was made in the role the RACI names.",
      "dimensions": [
        "collaboration"
      ],
      "areas": [
        "ops",
        "docs",
        "grc"
      ]
    },
    {
      "id": "decisions",
      "label": "Decisions",
      "unit": "A decision block chosen by this member, or a change row with its reason written.",
      "success": "Justified: every required supporting question answered; approved by the team.",
      "dimensions": [
        "decisions"
      ],
      "areas": [
        "arch",
        "risk",
        "grc",
        "continuity",
        "ops"
      ]
    },
    {
      "id": "projects",
      "label": "Projects",
      "unit": "A graded week sealed on a capstone.",
      "success": "The capstone document issued.",
      "dimensions": [],
      "areas": [
        "docs",
        "ops",
        "arch"
      ]
    },
    {
      "id": "exam-domains",
      "label": "Exam domains",
      "unit": "A verified step on a task that practises the domain.",
      "success": "Verified; weighted by the published blueprint.",
      "dimensions": [
        "domains"
      ],
      "areas": [
        "grc",
        "harden",
        "network",
        "sysadmin",
        "cloud",
        "detect",
        "respond",
        "arch"
      ]
    }
  ],
