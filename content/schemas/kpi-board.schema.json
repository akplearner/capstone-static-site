{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capstone.example/schemas/kpi-board.schema.json",
  "title": "KPI board",
  "description": "The sixteen numbers one course keeps for one member (capstone-kpi-board/1): four families of four, each a ratio of counts with the kind of fact it reads and whether that fact was loaded. Nothing is scored, ranked or timed.",
  "type": "object",
  "required": ["schema", "ontologyVersion", "courseId", "role", "workRoles", "measuredAgainst", "families", "kpis"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "capstone-kpi-board/1" },
    "ontologyVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "courseId": { "type": "string", "minLength": 1 },
    "role": { "type": "string", "minLength": 1 },
    "workRoles": { "type": "array", "items": { "type": "string", "pattern": "^role\\.[a-z0-9][a-z0-9-]*$" } },
    "measuredAgainst": {
      "type": "object",
      "required": ["kind", "id", "label", "required", "untaught"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["work-role", "profile"] },
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "required": { "type": "integer", "minimum": 0 },
        "untaught": { "type": "integer", "minimum": 0 }
      }
    },
    "families": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "additionalProperties": false,
        "properties": {
          "id": { "enum": ["ability", "execution", "procedure", "outcome"] },
          "label": { "type": "string" }
        }
      }
    },
    "kpis": { "type": "array", "minItems": 16, "maxItems": 16, "items": { "$ref": "#/$defs/kpiValue" } }
  },
  "$defs": {
    "kpiValue": {
      "type": "object",
      "required": ["id", "family", "metricId", "value", "of", "pct", "loaded", "fact"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^kpi\\.(ability|execution|procedure|outcome)\\.[a-z][a-z0-9-]*$" },
        "family": { "enum": ["ability", "execution", "procedure", "outcome"] },
        "metricId": { "type": "string", "pattern": "^metric\\.[a-z][a-z0-9-]*$" },
        "value": { "type": "integer", "minimum": 0 },
        "of": { "type": "integer", "minimum": 0 },
        "pct": { "type": "integer", "minimum": 0, "maximum": 100 },
        "loaded": { "type": "boolean" },
        "fact": { "enum": ["own", "team", "content"] },
        "beside": {
          "type": "object",
          "required": ["value", "of"],
          "additionalProperties": false,
          "properties": {
            "value": { "type": "integer", "minimum": 0 },
            "of": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
