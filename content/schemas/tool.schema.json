{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capstone.example/schemas/tool.schema.json",
  "title": "Tool",
  "description": "One tool of the register: an id, a short label, its kind, the strings that mean it and the command heads that prove it ran.",
  "type": "object",
  "required": [
    "id",
    "label",
    "kind",
    "aliases"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^tool\\.[a-z0-9][a-z0-9-]*$"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "cli",
        "app",
        "portal",
        "service",
        "platform",
        "appliance",
        "hardware",
        "document",
        "language"
      ]
    },
    "vendor": {
      "type": "string"
    },
    "url": {
      "type": "string",
      "pattern": "^https?://"
    },
    "aliases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
