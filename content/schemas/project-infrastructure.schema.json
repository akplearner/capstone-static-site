{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capstone.example/schemas/project-infrastructure.schema.json",
  "title": "Project infrastructure",
  "description": "R141: capstone-project-infrastructure/1 \u2014 a team's infrastructure as the record reads it: every host with its addresses and ports and what it was given (vCPU, RAM, disk), the totals against what the hardware discovery reported, who last changed each form and how many versions it has (migration 0025), and the dependencies, flows and resources recorded. Team-level; the instructor console builds and downloads it.",
  "type": "object",
  "required": [
    "schema",
    "courseId",
    "teamId",
    "hosts",
    "resourcesAllocated",
    "capacity",
    "ownership",
    "dependencies",
    "flows",
    "resources"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "capstone-project-infrastructure/1"
    },
    "courseId": {
      "type": "string",
      "minLength": 1
    },
    "teamId": {
      "type": "string",
      "minLength": 1
    },
    "hosts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "host",
          "declared",
          "addresses",
          "ports",
          "vcpu",
          "ramGb",
          "diskGb"
        ],
        "additionalProperties": false,
        "properties": {
          "host": {
            "type": "string",
            "minLength": 1
          },
          "declared": {
            "type": "boolean"
          },
          "addresses": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "ports": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "vcpu": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "ramGb": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "diskGb": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "resourcesAllocated": {
      "type": "object",
      "required": [
        "vcpu",
        "ramGb",
        "diskGb"
      ],
      "additionalProperties": false,
      "properties": {
        "vcpu": {
          "type": "number",
          "minimum": 0
        },
        "ramGb": {
          "type": "number",
          "minimum": 0
        },
        "diskGb": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "capacity": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "found",
            "ramGb",
            "threads"
          ],
          "additionalProperties": false,
          "properties": {
            "found": {
              "type": "string"
            },
            "ramGb": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "threads": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "ownership": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "deliverableId",
          "lastChangedBy",
          "lastChangedAt",
          "versions"
        ],
        "additionalProperties": false,
        "properties": {
          "deliverableId": {
            "type": "string",
            "minLength": 1
          },
          "lastChangedBy": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "lastChangedAt": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "versions": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "label",
          "value",
          "form"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "form": {
            "type": "string",
            "minLength": 1
          },
          "host": {
            "type": "string"
          }
        }
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "label",
          "value",
          "form"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "form": {
            "type": "string",
            "minLength": 1
          },
          "host": {
            "type": "string"
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "label",
          "value",
          "form"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "form": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
