{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capstone.example/schemas/competency-node.schema.json",
  "title": "Competency node",
  "description": "One node of the competency ontology: a stable id, a semver, an imperative label, its area and the exam domains or controls it is anchored to.",
  "type": "object",
  "required": [
    "id",
    "version",
    "label",
    "area",
    "objectiveRefs"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^comp\\.[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "area": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "objectiveRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "parents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deprecated": {
      "type": "boolean"
    }
  }
}
