                    "of"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "value": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "of": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                },
                "unit": {
                  "enum": [
                    "ratio",
                    "count",
                    "minutes"
                  ]
                },
                "scored": {
                  "type": "boolean"
                },
