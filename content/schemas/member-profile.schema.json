                        ],
                        "minimum": 0,
                        "maximum": 100
                      },
                      "counted": {
                        "type": "boolean"
                      }
                    }
                  }
                },
                "offered": {
                  "description": "R137: how much the course offers the role to measure here; zero means not measured for the role.",
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "description": "The board's scores; a link's copy leaves out the components (the published weights and the KPIs restore them)."
