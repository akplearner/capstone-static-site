        "verified",
        "selfAttested",
        "verificationRate",
        "artifacts",
        "artifactsNamedWell",
        "attempts",
        "firstActivity",
        "lastActivity",
        "activeDays",
        "frameworksVerified",
        "frameworksTotal",
        "receipted",
        "rehashConfirmed"
      ],
      "additionalProperties": false,
      "properties": {
        "courseId": {
          "type": "string"
        },
        "courseTitle": {
          "type": "string"
        },
        "stepsDone": {
          "type": "integer",
          "minimum": 0
        },
        "stepsTotal": {
          "type": "integer",
          "minimum": 0
        },
        "verifiable": {
          "type": "integer",
          "minimum": 0
        },
        "verified": {
          "type": "integer",
          "minimum": 0
        },
        "selfAttested": {
          "type": "integer",
          "minimum": 0
        },
        "verificationRate": {
          "type": "integer",
          "minimum": 0
        },
        "artifacts": {
          "type": "integer",
          "minimum": 0
        },
        "artifactsNamedWell": {
          "type": "integer",
          "minimum": 0
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "activeDays": {
          "type": "integer",
          "minimum": 0
        },
        "firstActivity": {
          "type": "number",
          "minimum": 0
        },
        "lastActivity": {
          "type": "number",
          "minimum": 0
        },
        "frameworksVerified": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "frameworksTotal": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "receipted": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "rehashConfirmed": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "artifact": {
      "type": "object",
      "required": [
        "courseId",
        "sha256",
        "filename",
        "sizeBytes",
        "nameOk",
        "hashedAt"
      ],
      "additionalProperties": false,
      "properties": {
        "courseId": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "filename": {
          "type": "string"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "week": {
          "type": "integer",
          "minimum": 0
        },
        "deliverableId": {
          "type": "string"
        },
        "nameOk": {
          "type": "boolean"
        },
        "hashedAt": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "recordCategory": {
      "type": "object",
      "required": [
        "id",
        "utilization",
        "verifiedUses",
        "successRate",
        "courses",
        "projects",
        "trend",
        "evidenceCount",
        "relevance",
        "tier",
        "threshold"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "tools",
            "commands",
            "procedures",
            "standards",
            "troubleshooting",
            "investigations",
            "documentation",
            "architectures",
            "configurations",
            "communication",
            "collaboration",
            "decisions",
            "projects",
            "exam-domains"
          ]
        },
        "utilization": {
          "type": "integer",
          "minimum": 0
        },
        "verifiedUses": {
          "type": "integer",
          "minimum": 0
        },
        "successRate": {
          "type": "object",
          "required": [
            "value",
            "of"
          ],
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "integer",
              "minimum": 0
            },
            "of": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "lastActivityAt": {
          "type": "number",
          "minimum": 0
        },
        "courses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "projects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "trend": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "evidenceCount": {
          "type": "integer",
          "minimum": 0
        },
        "relevance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "tier": {
          "enum": [
            "professional",
            "building"
          ]
        },
        "threshold": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "competency": {
      "type": "object",
      "required": [
        "schema",
        "courseId",
        "role",
        "facets"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "capstone-competency/1"
        },
        "courseId": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "facets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "value",
              "counted",
              "of",
              "loaded"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "enum": [
                  "decisionQuality",
                  "investigationQuality",
                  "troubleshootingSuccess",
                  "processCompliance",
                  "collaboration",
                  "communication",
                  "reliability",
                  "independence"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "counted": {
                "type": "integer",
                "minimum": 0
              },
              "of": {
                "type": "integer",
                "minimum": 1
              },
              "loaded": {
                "type": "boolean"
              },
              "components": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "kpi",
                    "weight",
                    "pct",
                    "counted"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "kpi": {
                      "type": "string",
                      "pattern": "^kpi\\.[a-z-]+\\.[a-z][a-z0-9-]*$"
                    },
                    "weight": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "pct": {
                      "anyOf": [
                        {
                          "type": "integer"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "counted": {
                      "type": "boolean"
                    }
                  }
                },
                "minItems": 1
              },
              "caveat": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "minItems": 8,
          "maxItems": 8
        }
      },
      "description": "R141: the facets; a link's copy carries the figure only (id, value, counted, of, loaded) and the reader restores the label, the components and the caveat from the registry."
    },
    "portfolio": {
      "type": "object",
      "description": "R142: what the team can show for the project, from the Portfolio form. A link's copy carries the repository, the bullets, the diagram and whether the case study reached two hundred words; the case study itself and the skills table stay with the member.",
      "required": [
        "formId",
        "repoUrl",
        "bullets",
        "diagramRef",
        "caseStudyWords",
        "complete"
      ],
      "additionalProperties": false,
      "properties": {
        "formId": {
          "type": "string"
        },
        "repoUrl": {
          "type": "string"
        },
        "caseStudy": {
          "type": "string"
        },
        "caseStudyWords": {
          "type": "integer",
          "minimum": 0
        },
        "complete": {
          "type": "boolean"
        },
        "bullets": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string"
          }
        },
        "diagramRef": {
          "type": "string"
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "skill",
              "evidence",
              "where"
            ],
            "additionalProperties": false,
            "properties": {
              "skill": {
                "type": "string"
              },
              "evidence": {
                "type": "string"
              },
              "where": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "skillValidation": {
      "type": "object",
      "required": [
        "schema",
        "courseId",
        "role",
        "skills"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "capstone-skill-validation/1"
        },
        "courseId": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "skillId",
              "label",
              "firstDemonstratedAt",
              "lastValidatedAt",
              "validationCount",
              "correctCount",
              "confidence",
              "retained"
            ],
            "additionalProperties": false,
            "properties": {
              "skillId": {
                "type": "string",
                "pattern": "^comp\\.[a-z-]+\\.[a-z0-9-]+$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "firstDemonstratedAt": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "lastValidatedAt": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "validationCount": {
                "type": "integer",
                "minimum": 0
              },
              "correctCount": {
                "type": "integer",
                "minimum": 0
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "retained": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  },
  "type": "object",
