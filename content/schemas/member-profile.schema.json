                  "type": "boolean"
                },
                "notMeasured": {
                  "description": "R137: 'role' \u2014 not measured in this course for this role; 'yet' \u2014 nothing to count yet.",
                  "enum": [
                    "role",
                    "yet"
                  ]
                }
              }
            },
            "description": "The board's rows; the full export carries family, metricId, unit and scored, which a link's copy leaves out (the ontology restores them by id)."
