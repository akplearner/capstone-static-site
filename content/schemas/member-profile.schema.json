          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "denominator": {
          "const": "own ticks \u00b7 graded weeks \u00b7 required steps"
        },
        "rows": {
          "type": "object",
          "required": [
            "skills",
            "tools",
            "procedures",
            "tactics",
            "practices",
            "standards",
            "domains",
            "evidence",
            "documentation",
            "collaboration",
            "ability",
            "execution",
            "troubleshooting",
            "decisions",
            "retention"
          ],
          "additionalProperties": false,
          "properties": {
            "skills": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/row"
              }
            },
            "tools": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/row"
              }
            },
            "procedures": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/row"
              }
            },
            "tactics": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/row"
              }
            },
            "practices": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/row"
              }
            },
            "standards": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/row"
              }
            },
            "domains": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/row"
              }
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/row"
              }
            },
            "documentation": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/row"
              }
            },
            "collaboration": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/row"
              }
            },
            "ability": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/row"
              }
            },
            "execution": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/row"
              }
            },
            "troubleshooting": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/row"
              }
            },
            "decisions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/row"
              }
            },
            "retention": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/row"
              }
            }
          }
        },
        "abilities": {
          "type": "object",
          "required": [
            "firstTry",
            "persistence",
            "partialProgress",
            "evidenceNaming",
            "activeDays",
            "activeWeeks",
            "reportsFiled",
            "reportsResolved",
            "notesWritten",
            "drafted",
            "reviewed",
            "issued",
            "submissionsFrozen",
            "rubricAllGreen",
            "dodMet",
            "teammateStepsTicked",
            "handoffsCompleted",
            "peerReviewsGiven",
            "inOrder",
            "commandSteps",
            "controlsCited",
            "docControl",
            "instructorApproved",
            "raciRespected",
            "receipted",
            "rehashConfirmed",
            "faultsResolved",
            "changeRollback",
            "decisionsRecorded",
            "decisionsJustified",
            "decisionsApproved",
            "rationaleWritten",
            "reviewMarks",
            "flagsCleared",
            "onTime",
            "retention",
            "skillsCurrent",
            "learningVelocity",
            "recallAccuracy",
            "scenariosApplied",
            "conflictsResolved",
            "timeOnTask"
          ],
          "additionalProperties": false,
          "properties": {
            "firstTry": {
              "$ref": "#/$defs/indicator"
            },
            "persistence": {
              "$ref": "#/$defs/indicator"
            },
            "partialProgress": {
              "$ref": "#/$defs/indicator"
            },
            "evidenceNaming": {
              "$ref": "#/$defs/indicator"
            },
            "activeDays": {
              "$ref": "#/$defs/indicator"
            },
            "activeWeeks": {
              "$ref": "#/$defs/indicator"
            },
            "reportsFiled": {
              "$ref": "#/$defs/indicator"
            },
            "reportsResolved": {
              "$ref": "#/$defs/indicator"
            },
            "notesWritten": {
              "$ref": "#/$defs/indicator"
            },
            "drafted": {
              "$ref": "#/$defs/indicator"
            },
            "reviewed": {
              "$ref": "#/$defs/indicator"
            },
            "issued": {
              "$ref": "#/$defs/indicator"
            },
            "submissionsFrozen": {
              "$ref": "#/$defs/indicator"
            },
            "rubricAllGreen": {
              "$ref": "#/$defs/indicator"
            },
            "dodMet": {
              "$ref": "#/$defs/indicator"
            },
            "teammateStepsTicked": {
              "$ref": "#/$defs/indicator"
            },
            "handoffsCompleted": {
              "$ref": "#/$defs/indicator"
            },
            "peerReviewsGiven": {
              "$ref": "#/$defs/indicator"
            },
            "inOrder": {
              "$ref": "#/$defs/indicator"
            },
            "commandSteps": {
              "$ref": "#/$defs/indicator"
            },
            "controlsCited": {
              "$ref": "#/$defs/indicator"
            },
            "docControl": {
              "$ref": "#/$defs/indicator"
            },
            "instructorApproved": {
              "$ref": "#/$defs/indicator"
            },
            "raciRespected": {
              "$ref": "#/$defs/indicator"
            },
            "receipted": {
              "$ref": "#/$defs/indicator"
            },
            "rehashConfirmed": {
              "$ref": "#/$defs/indicator"
            },
            "faultsResolved": {
              "$ref": "#/$defs/indicator"
            },
            "changeRollback": {
              "$ref": "#/$defs/indicator"
            },
            "decisionsRecorded": {
              "$ref": "#/$defs/indicator"
            },
            "decisionsJustified": {
              "$ref": "#/$defs/indicator"
            },
            "decisionsApproved": {
              "$ref": "#/$defs/indicator"
            },
            "rationaleWritten": {
              "$ref": "#/$defs/indicator"
            },
            "reviewMarks": {
              "$ref": "#/$defs/indicator"
            },
            "flagsCleared": {
              "$ref": "#/$defs/indicator"
            },
            "onTime": {
              "$ref": "#/$defs/indicator"
            },
            "retention": {
              "$ref": "#/$defs/indicator"
            },
            "skillsCurrent": {
              "$ref": "#/$defs/indicator"
            },
            "learningVelocity": {
              "$ref": "#/$defs/indicator"
            },
            "recallAccuracy": {
              "$ref": "#/$defs/indicator"
            },
            "scenariosApplied": {
              "$ref": "#/$defs/indicator"
            },
            "conflictsResolved": {
              "$ref": "#/$defs/indicator"
            },
            "timeOnTask": {
              "$ref": "#/$defs/indicator"
            }
          }
        },
        "gaps": {
          "type": "object",
          "required": [
            "domains",
            "skills",
            "sops"
          ],
          "additionalProperties": false,
          "properties": {
            "domains": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/row"
              }
            },
            "skills": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/row"
              }
            },
            "sops": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/row"
              }
            }
          }
        },
        "loaded": {
          "type": "object",
          "required": [
            "team",
            "own"
          ],
          "additionalProperties": false,
          "properties": {
            "team": {
              "type": "boolean"
            },
            "own": {
              "type": "boolean"
            }
          }
        },
        "draftedForms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "timing": {
          "type": "object",
          "required": [
            "timedSteps",
            "medianMinutes",
            "withinHour",
            "over24h"
          ],
          "additionalProperties": false,
          "properties": {
            "timedSteps": {
              "type": "integer",
              "minimum": 0
            },
            "medianMinutes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "withinHour": {
              "type": "integer",
              "minimum": 0
            },
            "over24h": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "row": {
      "type": "object",
      "required": [
        "id",
        "level"
      ],
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "enum": [
            "skills",
            "tools",
            "procedures",
            "tactics",
            "practices",
            "standards",
            "domains",
            "evidence",
            "documentation",
            "collaboration",
            "ability",
            "execution",
            "troubleshooting",
            "decisions",
            "retention"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "standardRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exercisedTasks": {
          "type": "integer",
          "minimum": 0
        },
        "doneTasks": {
          "type": "integer",
          "minimum": 0
        },
        "requiredSteps": {
          "type": "integer",
          "minimum": 0
        },
        "tickedSteps": {
          "type": "integer",
          "minimum": 0
        },
        "verifiableSteps": {
          "type": "integer",
          "minimum": 0
        },
        "verifiedSteps": {
          "type": "integer",
          "minimum": 0
        },
        "selfAttestedSteps": {
          "type": "integer",
          "minimum": 0
        },
        "verifiedTasks": {
          "type": "integer",
          "minimum": 0
        },
        "inOrderTasks": {
          "type": "integer",
          "minimum": 0
        },
        "orderedTasks": {
          "type": "integer",
          "minimum": 0
        },
        "artifacts": {
          "type": "integer",
          "minimum": 0
        },
        "deliverables": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deliverablesFilled": {
          "type": "integer",
          "minimum": 0
        },
        "deliverablesControlled": {
          "type": "integer",
          "minimum": 0
        },
        "deliverablesApproved": {
          "type": "integer",
          "minimum": 0
        },
        "draftedByMember": {
          "type": "integer",
          "minimum": 0
        },
        "level": {
          "enum": [
            "not-started",
            "practised",
            "verified",
            "reviewed"
          ]
        },
        "next": {
          "type": "object",
          "required": [
            "taskId",
            "title",
            "week"
          ],
          "additionalProperties": false,
          "properties": {
            "taskId": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "week": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "lastVerifiedAt": {
          "type": "number",
          "minimum": 0
        },
        "current": {
          "type": "boolean"
        },
        "firstVerifiedAt": {
          "type": "number",
          "minimum": 0
        },
        "retained": {
          "type": "boolean"
        },
        "uses": {
          "type": "integer",
          "minimum": 0
        },
        "successes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "indicator": {
      "type": "object",
      "required": [
        "value",
        "loaded"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0
        },
        "of": {
          "type": "number",
          "minimum": 0
        },
        "loaded": {
          "type": "boolean"
        },
        "own": {
          "type": "object",
          "required": [
            "value",
            "of"
          ],
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0
            },
            "of": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "offered": {
          "description": "R137: how much the course offers the role to measure here; zero means not measured for the role.",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "metrics": {
      "type": "object",
      "required": [
        "courseId",
        "courseTitle",
        "stepsDone",
        "stepsTotal",
