              "type": "string",
              "pattern": "^role\\.[a-z0-9][a-z0-9-]*$"
            }
          },
          "kpis": {
            "type": "array",
            "minItems": 28,
            "maxItems": 28,
            "items": {
              "type": "object",
              "required": [
                "id",
                "value",
                "of",
                "pct",
                "loaded",
                "fact"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^kpi\\.(technical|problem-solving|execution|decision-making|teamwork|professionalism|growth)\\.[a-z][a-z0-9-]*$"
                },
                "family": {
                  "enum": [
                    "technical",
                    "problem-solving",
                    "execution",
                    "decision-making",
                    "teamwork",
                    "professionalism",
                    "growth"
                  ]
                },
                "metricId": {
                  "type": "string",
                  "pattern": "^metric\\.[a-z][a-z0-9-]*$"
                },
                "value": {
                  "type": "integer",
                  "minimum": 0
                },
                "of": {
                  "type": "integer",
                  "minimum": 0
                },
                "pct": {
                  "type": "integer",
                  "minimum": 0,
